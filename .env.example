# SecChat backend configuration. Copy to `.env` and fill in. No secrets have defaults —
# a missing REQUIRED value fails closed at startup.

# --- required ---
# SecSSO (Authentik) OIDC issuer for THIS app. Its JWKS is the only trust root for user tokens.
SECCHAT_OIDC_ISSUER=https://sso.sec.internal/application/o/secchat/
# The audience SecChat's tokens must carry (its OIDC client id). Tokens for other audiences are rejected.
SECCHAT_OIDC_AUDIENCE=secchat

# --- optional (shown with their defaults) ---
# SECCHAT_HOST=127.0.0.1
# SECCHAT_PORT=47010
# JWKS endpoint; derived from the issuer when unset (<issuer>/.well-known/jwks.json).
# SECCHAT_JWKS_URL=
# SecRouter gateway base URL — the assistant path (Sprint 3) routes model calls here.
# SECROUTER_URL=http://127.0.0.1:47002
# Postgres DSN. Unset ⇒ in-memory store (dev/test only). The Postgres store lands in Sprint 2.
# DATABASE_URL=postgres://secchat:CHANGEME@127.0.0.1:5432/secchat

# --- SSO login (OIDC BFF) ---
# The backend runs the OIDC Authorization Code + PKCE flow itself and issues an httpOnly session
# cookie — no OIDC token ever reaches the browser (see src/auth/bff.ts). Leave any one of the
# three unset and SSO login is simply disabled (/auth/login|callback|logout return 503); the
# Bearer-JWT path above (and dev tokens under SECCHAT_DEV_MODE=1) keep working either way.

# OIDC client id for the login flow. Defaults to SECCHAT_OIDC_AUDIENCE above (the same SecChat
# OIDC client is normally used for both the bearer-JWT audience check and the login flow).
# SECCHAT_OIDC_CLIENT_ID=

# Confidential-client secret for the server-side token exchange. SecSSO mints this when the
# secchatng blueprint is applied.
# SECCHAT_OIDC_CLIENT_SECRET=

# External base URL this app is reachable at (e.g. https://secchat.sec.internal) — builds the
# OIDC redirect_uri (<SECCHAT_PUBLIC_URL>/auth/callback) and decides the cookie `Secure` flag.
# SECCHAT_PUBLIC_URL=

# Session cookie TTL, seconds.
# SECCHAT_SESSION_TTL=28800

# HS256 signing key for the SecChat-minted session cookie. Blank on purpose: SecDeploy auto-seeds
# a strong value at deploy time (the same stack-secret convention as PG_PASSWORD below).
SECCHAT_SESSION_SECRET=

# --- stack deploy (compose) ---
# Everything below is read by compose.yaml / bootstrap/secchat.sh, not by the app process
# directly (the app only ever sees DATABASE_URL, which compose derives from PG_PASSWORD below
# and injects itself — do NOT set DATABASE_URL in this file for the compose deploy path).

# Postgres password for the compose stack's own `postgres` service. Blank on purpose: SecDeploy
# auto-seeds a strong value at deploy time (the suite convention for stack secrets). For a
# standalone/manual deploy, set this yourself before `./bootstrap/secchat.sh up`.
PG_PASSWORD=

# Host port the stack publishes (defaults to 47010 — see compose.yaml).
# SECCHAT_HTTP_PORT=47010

# SecRouter gateway base URL — the assistant path (spawned agents) routes model calls here.
# SECROUTER_URL=http://secrouter:47002

# SecSSO group whose members may read the admin / audit-review console (/admin*).
# SECCHAT_ADMIN_GROUP=secchat-admins
