# SecChat (Mattermost Team Edition) — copy to .env and fill in.
# Pin to the current stable Mattermost release (https://docs.mattermost.com/about/version-archive.html).
MATTERMOST_TAG=10.5

# Postgres
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=
POSTGRES_DB=mattermost

# Mattermost site URL clients use (must match the SSO redirect); use https:// behind a proxy.
MM_SITE_URL=http://localhost:8065
SECCHAT_HTTP_PORT=8065

# ── SSO via SecSSO ──────────────────────────────────────────────────────────
# Mattermost Team Edition does SSO through its GitLab connector; SecSSO (Authentik)
# presents GitLab-compatible OAuth endpoints. See docs/sso.md. Leave disabled to use
# local accounts, or point these at your own IdP.
MM_GITLAB_ENABLE=false
MM_GITLAB_ID=secchat
MM_GITLAB_SECRET=
MM_GITLAB_AUTH_ENDPOINT=http://localhost:9000/application/o/authorize/
MM_GITLAB_TOKEN_ENDPOINT=http://localhost:9000/application/o/token/
MM_GITLAB_USER_ENDPOINT=http://localhost:9000/application/o/userinfo/
