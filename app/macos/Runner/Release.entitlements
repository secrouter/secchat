<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOT sandboxed: the desktop app supervises a bundled runner daemon that shells out to the
	     external `pi` coding-agent CLI. The App Sandbox only permits execing binaries INSIDE the
	     bundle, so a sandboxed build can't run pi (there's no entitlement for external exec — it's
	     a process-execution limit, not a file-access one). This build targets NON-App-Store
	     distribution (Developer ID + notarization / hardened runtime), where the sandbox isn't
	     required. Re-add com.apple.security.app-sandbox (and bundle pi) only for the Mac App Store. -->
</dict>
</plist>
